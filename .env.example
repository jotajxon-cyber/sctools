# copie para .env e ajuste: cp .env.example .env

# URL PÚBLICA da sua API (obrigatória).
# em produção use https://api.seudominio.com/
API_URL=http://localhost:9000/

# porta local exposta pelo compose
API_PORT=9000

# youtube / sessão
YOUTUBE_SESSION_INNERTUBE_CLIENT=WEB_EMBEDDED
YOUTUBE_ALLOW_BETTER_AUDIO=1

# ATENÇÃO: NÃO defina DISABLED_SERVICES com "youtube".
# DISABLED_SERVICES=

# usada no BUILD do frontend (não pelo compose):
# WEB_DEFAULT_API=http://localhost:9000/
